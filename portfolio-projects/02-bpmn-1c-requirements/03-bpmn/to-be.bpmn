<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Request" targetNamespace="https://druzhinskaia.github.io/bpmn" exporter="Portfolio model builder" exporterVersion="1.0">
  <bpmn:process id="RequestProcess" name="Обработка заявок" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_0" name="Инициатор">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>clarify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Менеджер">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acceptwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Руководитель">
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Исполнитель">
        <bpmn:flowNodeRef>execute</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Запрос поступил">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="register" name="Сохранить данные заявки">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="check" name="Данные полные?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="clarify" name="Уточнить данные">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="route" name="Нужно согласование?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="approve" name="Рассмотреть заявку">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="decision" name="Решение?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="rejected" name="Отклонена">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="acceptwork" name="Принять в работу">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="execute" name="Выполнить заявку">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="review" name="Проверить результат">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="accepted" name="Результат принят?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="close" name="Закрыть заявку">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="closed" name="Закрыта">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="start" targetRef="register" name="" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="register" targetRef="check" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="check" targetRef="clarify" name="Нет" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="clarify" targetRef="register" name="" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="check" targetRef="route" name="Да" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="route" targetRef="acceptwork" name="Нет" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="route" targetRef="approve" name="Да" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="approve" targetRef="decision" name="" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="decision" targetRef="rejected" name="Отказ" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="decision" targetRef="acceptwork" name="Согласовано" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="decision" targetRef="clarify" name="Уточнить" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="acceptwork" targetRef="execute" name="" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="execute" targetRef="review" name="" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="review" targetRef="accepted" name="" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="accepted" targetRef="close" name="Да" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="close" targetRef="closed" name="" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="accepted" targetRef="execute" name="Доработать" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Pool" name="Обработка заявок" processRef="RequestProcess" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true">
        <dc:Bounds x="20" y="60" width="2340" height="1040" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true">
        <dc:Bounds x="60" y="60" width="2300" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="60" y="240" width="2300" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true">
        <dc:Bounds x="60" y="600" width="2300" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_3_di" bpmnElement="Lane_3" isHorizontal="true">
        <dc:Bounds x="60" y="840" width="2300" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="205" y="137" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="register_di" bpmnElement="register">
        <dc:Bounds x="270" y="295" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check_di" bpmnElement="check">
        <dc:Bounds x="555" y="305" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="clarify_di" bpmnElement="clarify">
        <dc:Bounds x="475" y="115" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="route_di" bpmnElement="route">
        <dc:Bounds x="750" y="305" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_di" bpmnElement="approve">
