        <dc:Bounds x="1160" y="665" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rejected_di" bpmnElement="rejected">
        <dc:Bounds x="1340" y="677" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="acceptwork_di" bpmnElement="acceptwork">
        <dc:Bounds x="1310" y="295" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="execute_di" bpmnElement="execute">
        <dc:Bounds x="1310" y="895" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review_di" bpmnElement="review">
        <dc:Bounds x="1630" y="295" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="accepted_di" bpmnElement="accepted">
        <dc:Bounds x="1900" y="305" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="close_di" bpmnElement="close">
        <dc:Bounds x="2000" y="295" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="closed_di" bpmnElement="closed">
        <dc:Bounds x="2290" y="317" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="241" y="155" />
        <di:waypoint x="250" y="155" />
        <di:waypoint x="250" y="335" />
        <di:waypoint x="270" y="335" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="490" y="335" />
